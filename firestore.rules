rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Validates that task document has required fields, valid types, and no unexpected keys
    function isValidTask() {
      let incoming = request.resource.data;
      let allowedKeys = ['id', 'userId', 'planId', 'day', 'title', 'description', 'status', 'createdAt', 'approvedAt'];
      let requiredKeys = ['userId', 'title', 'status', 'createdAt', 'approvedAt'];
      
      return incoming.keys().hasAll(requiredKeys) &&
             incoming.keys().hasOnly(allowedKeys) &&
             incoming.userId is string &&
             incoming.title is string &&
             incoming.title.size() > 0 &&
             incoming.status in ['pending', 'completed'] &&
             incoming.createdAt is number &&
             incoming.approvedAt is number;
    }

    // Tasks collection: scoped strictly to authenticated owner
    match /tasks/{taskId} {
      allow read: if request.auth != null && 
                     resource != null && 
                     request.auth.uid == resource.data.userId;
                     
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId &&
                       isValidTask();
                       
      allow update: if request.auth != null && 
                       resource != null && 
                       request.auth.uid == resource.data.userId && 
                       request.auth.uid == request.resource.data.userId &&
                       isValidTask();
                       
      allow delete: if request.auth != null && 
                       resource != null && 
                       request.auth.uid == resource.data.userId;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
